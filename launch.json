{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Campus AI: Run in Chrome (F5)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000/login.php",
            "webRoot": "${workspaceFolder}/chetan-project",
            "preLaunchTask": "Start Campus AI (Server & Database)"
        },
        {
            "name": "Campus AI: Run in Edge (F5)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:8000/login.php",
            "webRoot": "${workspaceFolder}/chetan-project",
            "preLaunchTask": "Start Campus AI (Server & Database)"
        },
        {
            "name": "Campus AI: Run with PHP Server (Devsense)",
            "type": "php",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/chetan-project/php/php.exe",
            "runtimeArgs": [
                "-S",
                "localhost:8000",
                "-t",
                "${workspaceFolder}/chetan-project"
            ],
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
                "uriFormat": "http://localhost:%s/login.php",
                "action": "openExternally"
            }
        }
    ]
}