{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Campus AI (Server & Database)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/run.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Campus AI",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/stop.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start PHP Server in Terminal (Live Logs)",
            "type": "shell",
            "command": "${workspaceFolder}/chetan-project/php/php.exe",
            "args": [
                "-S",
                "localhost:8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/chetan-project"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Open Campus AI in Browser",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "start",
                "http://localhost:8000/login.php"
            ],
            "problemMatcher": []
        }
    ]
}
